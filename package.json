{
  "name": "drupalmcp-ts",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples"
  ],
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
