# The model. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# The Drupal site and the agent credential that `drush mcp:setup` printed.
# agent-draft may read and write; agent-publish may publish. Neither can do
# both, which is the point.
DRUPAL_BASE_URL=https://example.com
DRUPAL_CLIENT_ID=agent-draft
DRUPAL_CLIENT_SECRET=

# Only for a local site with a self-signed certificate, such as DDEV.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# For the from-drupal example: the agent's machine name in Drupal.
# Needs the MCP Agents module installed on the site.
DRUPAL_AGENT=site_editor
