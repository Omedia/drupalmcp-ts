    "test:live": "DRUPALMCP_LIVE=1 vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0"
  },
  "peerDependencies": {
    "@google/adk": "^2.0.0"
  },
  "devDependencies": {
    "@google/adk": "^2.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
